{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "fdisk*": "deny",
      "parted*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "kill *": "deny",
      "pkill *": "deny",
      "killall *": "deny",
      "chmod -R*": "deny",
      "chown -R*": "deny"
    },
    "external_directory": {
      "/pscratch/sd/p/pmtuan/.cache/colliderml/**": "allow",
      "/pscratch/sd/p/pmtuan/**": "allow",
      "/cvmfs/**": "allow",
      "/global/cfs/cdirs/m3443/**": "allow"
    }
  }
}
